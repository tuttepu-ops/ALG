# Copy to .env.local and fill in. Never commit .env.local.

# Required for live providers (server-side only, never sent to the browser)
OPENAI_API_KEY=
SARVAM_API_KEY=

# Private pilot access code. Paid endpoints (turn, speech, voice) require it.
PILOT_ACCESS_CODE=

# Signs session state. Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Hospital agent: "ai" (model writes replies, default) or "rules" (fixed lines)
# HOSPITAL_ENGINE=ai
# AGENT_MODEL=gpt-5.5
# AGENT_REASONING_EFFORT=none

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=none
# OPENAI_MAX_OUTPUT_TOKENS=60
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_TTS_SPEAKER=kavitha_te_conversation
# SARVAM_TTS_PACE=1.0
# Your Sarvam cloned voice (format svc-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx). When set, it becomes the
# default voice and replies use Sarvam's clone streaming endpoint (one natural take per reply, ~1 s).
SARVAM_CLONE_VOICE_ID=
# 24000 = laptop quality (default). 8000 = hear it the way a phone line will sound.
# SARVAM_TTS_SAMPLE_RATE=24000
# How common English words are sent to the voice: telugu (అపాయింట్మెంట్, default) or roman (appointment).
# SARVAM_ENGLISH_WORDS=telugu
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=codemix
# USD_INR=88

# Optional persistent outcome storage for Vercel (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ALG hosted dashboard and test calls
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM=
ALG_TEST_NUMBERS=
ALG_PUBLIC_URL=
PHONE_SECRET=

# Optional separate Ravi agent in Voice Studio
GEMINI_API_KEY=
# Force ws to use the JS path on Vercel
WS_NO_BUFFER_UTIL=1
